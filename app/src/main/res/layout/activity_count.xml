<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <org.agecore.app.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- The result can be long (intervals plus warnings). It scrolls, and it
         cannot grow until the photograph disappears. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/coreLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Core length (mm)"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <EditText
                android:id="@+id/ringWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ring width (mm)"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Count"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRedo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Redo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPartial"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Partial"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Save"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
