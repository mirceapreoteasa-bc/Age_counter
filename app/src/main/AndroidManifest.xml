<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DEBUG BUILDS ONLY (src/debug/AndroidManifest.xml overrides the
         permission away for release). The shipped app needs no storage
         permission: capture is delegated to the system camera and the work
         folder is a SAF tree chosen by the user. The batch test runner does
         need to enumerate the photo library, which under scoped storage
         requires READ_EXTERNAL_STORAGE. -->

    <!-- No CAMERA permission: capture is delegated to the system camera app
         via ACTION_IMAGE_CAPTURE, which needs no permission. No storage
         permission either: the work folder is chosen once through SAF. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgeCore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BatchActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CountActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
